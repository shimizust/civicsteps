# Supabase (from `npx supabase start` locally, or your project settings)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — https://platform.claude.com
ANTHROPIC_API_KEY=

# api.data.gov key — works for Congress.gov and Regulations.gov
API_DATA_GOV_KEY=
# https://open.pluralpolicy.com/accounts/profile/ (Open States)
OPENSTATES_API_KEY=

# Email (optional for local dev)
RESEND_API_KEY=
EMAIL_FROM="CivicSteps <alerts@example.org>"

# Max AI drafts per user per day
DRAFT_DAILY_LIMIT=10
NEXT_PUBLIC_SITE_URL=http://localhost:3000
