# Supabase (from `npx supabase start` locally, or your project settings)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API — https://platform.claude.com
ANTHROPIC_API_KEY=

# api.data.gov key — works for Congress.gov and Regulations.gov
API_DATA_GOV_KEY=
# https://open.pluralpolicy.com/accounts/profile/ (Open States)
OPENSTATES_API_KEY=

# Optional: when a user saves a ZIP in a state we haven't ingested yet, start .github/workflows/backfill.yml
# right away instead of waiting for the nightly run. Fine-grained GitHub token with "Actions: write" on the repo.
INGEST_DISPATCH_TOKEN=
INGEST_DISPATCH_REPO=owner/civicsteps
INGEST_DISPATCH_REF=main

# Email (optional for local dev)
RESEND_API_KEY=
EMAIL_FROM="CivicSteps <alerts@example.org>"

# Max AI drafts per user per day
DRAFT_DAILY_LIMIT=10
# Per-user daily limit for "Ask about my situation" (personal AI assessments; cached results are free).
ASSESS_DAILY_LIMIT=10
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map tiles for item locations (default: OpenStreetMap's public tiles, fine for light use; see
# https://operations.osmfoundation.org/policies/tiles/). For heavier traffic use a tile provider here.
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
