{
  "name": "civicsteps",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:types": "npx supabase gen types typescript --local > lib/supabase/database.types.ts",
    "ingest": "tsx --env-file-if-exists=.env.local ingest/run.ts",
    "gen:seed": "tsx scripts/gen-seed.ts",
    "gen:zcta": "tsx scripts/gen-zcta.ts",
    "notify": "tsx --env-file-if-exists=.env.local ingest/notify.ts",
    "facts:report": "tsx --env-file-if-exists=.env.local scripts/fact-demand.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "leaflet": "^1.9.4",
    "lucide-react": "1.66.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.33",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
